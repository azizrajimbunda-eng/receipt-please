{
  "name": "receipt-please",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8643 --strictPort --host",
    "build": "tsc -b && vite build",
    "build:artifact": "tsc -b && vite build --mode artifact",
    "preview": "vite preview --port 8643",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:case": "vitest run tests/linter.test.ts --reporter=verbose"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
